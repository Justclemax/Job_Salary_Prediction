# Copier en .env puis adapter :  cp .env.example .env

# Application Streamlit (lu nativement par Streamlit)
STREAMLIT_SERVER_PORT=8501

# Serveur d'inférence Rust (serving/)
API_HOST=127.0.0.1
API_PORT=8000
SALARY_MODEL_DIR=models/rust

# Adresse de l'API utilisée par le simulateur de l'application
SALARY_API_URL=http://127.0.0.1:${API_PORT}
